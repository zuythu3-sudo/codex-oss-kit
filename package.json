{
  "name": "codex-oss-kit",
  "version": "0.3.1",
  "private": false,
  "description": "Local Codex skills for open-source maintainers: repo readiness, README drift checks, and draft-only issue/PR/release workflows.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "oss-ready": "./.agents/skills/oss-ready/scripts/oss-ready.mjs",
    "docs-drift": "./.agents/skills/docs-drift/scripts/docs-drift.mjs",
    "bootstrap-kit": "./.agents/skills/bootstrap-kit/scripts/bootstrap-kit.mjs",
    "codex-oss-kit": "./.agents/skills/bootstrap-kit/scripts/bootstrap-kit.mjs"
  },
  "scripts": {
    "oss-ready": "node .agents/skills/oss-ready/scripts/oss-ready.mjs .",
    "docs-drift": "node .agents/skills/docs-drift/scripts/docs-drift.mjs .",
    "bootstrap": "node .agents/skills/bootstrap-kit/scripts/bootstrap-kit.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && node .agents/skills/oss-ready/scripts/oss-ready.mjs . && node .agents/skills/docs-drift/scripts/docs-drift.mjs ."
  },
  "homepage": "https://github.com/zuythu3-sudo/codex-oss-kit",
  "bugs": {
    "url": "https://github.com/zuythu3-sudo/codex-oss-kit/issues"
  },
  "files": [
    ".agents/skills",
    "action.yml",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "openai",
    "skills",
    "open-source",
    "maintainer",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zuythu3-sudo/codex-oss-kit.git"
  }
}
